# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dance_platform

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Storage
# Opciones: local | s3
VIDEO_STORAGE=local
VIDEO_STORAGE_LOCAL_PATH=./uploads

# S3 (para OCI Object Storage, MinIO o AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dance-platform-videos
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# Backend
PORT=3000
NODE_ENV=development
# Separar múltiples orígenes por coma; ej: local + VS Code tunnel
CORS_ORIGIN=http://localhost:5173
# lax | strict | none. Para el túnel de VS Code usar none + COOKIE_SECURE=true.
# Para localhost se fuerza lax/secure=false automáticamente según el Origin.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Frontend
# La API usa el prefijo /api. En local: http://localhost:3000/api
# En producción: https://api.video-repo.eduardosalasg.dev/api
# Si abres por el túnel de VS Code: https://<id>-3000.../api
VITE_API_URL=http://localhost:3000/api
