# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dance_platform

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Storage
# Opciones: local | s3
VIDEO_STORAGE=local
VIDEO_STORAGE_LOCAL_PATH=./uploads

# S3 (para OCI Object Storage, MinIO o AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dance-platform-videos
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# Backend
PORT=3000
NODE_ENV=development
# Separar múltiples orígenes por coma; usar '*' para permitir cualquiera (dev cuidado)
CORS_ORIGIN=http://localhost:5173
# lax | strict | none (none requiere COOKIE_SECURE=true y HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Frontend
VITE_API_URL=http://localhost:3000
