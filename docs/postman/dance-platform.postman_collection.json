    {
      "name": "Videos",
      "item": [
        {
          "name": "Upload video and metadata",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/sections/{{sectionId}}/videos",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "sections",
                "{{sectionId}}",
                "videos"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": "/path/to/video.mp4"
                },
                {
                  "key": "difficulty",
                  "value": "INTERMEDIATE",
                  "type": "text"
                },
                {
                  "key": "primaryStyle",
                  "value": "MAMBO_ON2",
                  "type": "text"
                },
                {
                  "key": "videoType",
                  "value": "STEP",
                  "type": "text"
                },
                {
                  "key": "durationCounts",
                  "value": "8",
                  "type": "text"
                },
                {
                  "key": "steps",
                  "value": "pausa",
                  "type": "text"
                },
                {
                  "key": "steps",
                  "value": "break",
                  "type": "text"
                },
                {
                  "key": "steps",
                  "value": "giro",
                  "type": "text"
                },
                {
                  "key": "influences",
                  "value": "Eddie Torres",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "timing",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "on2",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Get video URL",
          "request": {
            "method": "GET",
            "header": [],
