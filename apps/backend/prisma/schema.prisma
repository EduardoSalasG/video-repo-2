generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum AccessLevel {
  READ
  WRITE
  MAINTAIN
}

model Difficulty {
  value      String   @id
  label      String
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  videoMetadata VideoMetadata[]

  @@map("difficulties")
}

model PrimaryStyle {
  value      String   @id
  label      String
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  videoMetadata VideoMetadata[]
  videoLabels   VideoLabelStyle[]

  @@map("primary_styles")
}

model VideoType {
  value      String   @id
  label      String
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  videoMetadata VideoMetadata[]

  @@map("video_types")
}

model LabelType {
  value      String   @id
  label      String
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  videoLabels VideoLabel[]

  @@map("label_types")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  firstName    String
  lastName     String
  role         Role     @default(STUDENT)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courseAccess CourseAccess[]
  progress     UserSectionProgress[]

  @@map("users")
}

model Course {
  id              String  @id @default(uuid())
  name            String  @unique
  description     String?
  imageStorageKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modules      Module[]
  courseAccess CourseAccess[]

  @@map("courses")
}

model Module {
  id          String  @id @default(uuid())
  title       String
  description String?
  orderIndex  Int     @default(0)
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections Section[]

  @@map("modules")
}

model Section {
  id              String  @id @default(uuid())
  title           String
  description     String?
  orderIndex      Int     @default(0)
  moduleId        String
  module          Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  markdownContent String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  videoFile     VideoFile?    @relation(fields: [videoFileId], references: [id])
  videoFileId   String?       @unique
  videoMetadata VideoMetadata?
  progress      UserSectionProgress[]

  @@map("sections")
}

model VideoFile {
  id              String  @id @default(uuid())
  storageKey      String
  url             String?
  filename        String
  mimeType        String
  fileSize        Int?
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  section Section?

  @@map("video_files")
}

model VideoMetadata {
  id             String       @id @default(uuid())
  sectionId      String       @unique
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  difficulty     String
  difficultyRef  Difficulty   @relation(fields: [difficulty], references: [value])
  primaryStyle   String
  primaryStyleRef PrimaryStyle @relation(fields: [primaryStyle], references: [value])
  videoType      String
  videoTypeRef   VideoType    @relation(fields: [videoType], references: [value])
  durationCounts Int
  steps          String[]
  influences     String[]
  tags           String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("video_metadata")
}

model CourseAccess {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  accessLevel AccessLevel
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, courseId])
  @@map("course_access")
}

model UserSectionProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, sectionId])
  @@map("user_section_progress")
}

model VideoLabel {
  id        String            @id @default(uuid())
  name      String
  type      String
  typeRef   LabelType         @relation(fields: [type], references: [value])
  styles    VideoLabelStyle[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([name, type])
  @@map("video_labels")
}

model VideoLabelStyle {
  id        String     @id @default(uuid())
  labelId   String
  label     VideoLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  style     String
  styleRef  PrimaryStyle @relation(fields: [style], references: [value])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([labelId, style])
  @@map("video_label_styles")
}
